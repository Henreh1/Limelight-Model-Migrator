<Window x:Class="LimelightModelMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Limelight Model Migrator"
        Icon="Assets/Limelight.ico"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDrop="Window_PreviewDrop"
        Closing="Window_Closing"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Panel.ZIndex="500"
                Background="#0C0E1D"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="◆" Margin="0,0,10,0" FontSize="10"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}"/>
                    <TextBlock Text="LIMELIGHT" FontSize="13" FontWeight="Black" FontStyle="Italic"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  /  MODEL MIGRATOR" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock Text="  V0.1.0" Margin="9,0,0,0" FontSize="9"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="Minimise" Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimiseWindow_Click">
                        <Path Width="12" Height="1" Data="M 0,0 L 12,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"/>
                    </Button>
                    <Button ToolTip="Maximise or restore" Style="{StaticResource TitleBarButtonStyle}"
                            Click="ToggleMaximiseWindow_Click">
                        <Path Width="11" Height="11" Data="M 0.7,0.7 L 10.3,0.7 L 10.3,10.3 L 0.7,10.3 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"/>
                    </Button>
                    <Button ToolTip="Close" Style="{StaticResource CloseTitleBarButtonStyle}"
                            Click="CloseWindow_Click">
                        <Path Width="11" Height="11" Data="M 0.8,0.8 L 10.2,10.2 M 10.2,0.8 L 0.8,10.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="25,28,18,27">
                        <Image Source="Assets/LimelightIcon.png" Width="56" Height="56"
                               Margin="0,0,0,15" HorizontalAlignment="Left"/>
                        <TextBlock Text="LIMELIGHT" FontSize="27" FontWeight="Black" FontStyle="Italic"/>
                        <Rectangle Width="65" Height="3" Margin="0,7,0,0"
                                   HorizontalAlignment="Left" Fill="{StaticResource PinkBrush}"/>
                        <TextBlock Text="MODEL MIGRATOR" Margin="0,10,0,0" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Margin="8,3" Padding="16,13" Background="#25203B"
                                BorderBrush="{StaticResource PinkBrush}" BorderThickness="3,0,0,0"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" Width="27" FontSize="13"
                                           Foreground="{StaticResource PinkBrush}"/>
                                <TextBlock Text="Migrate Models" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="25,30,20,0">
                            <TextBlock Text="WORKFLOW" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="01  Choose project" Margin="0,14,0,0" FontSize="12"/>
                            <TextBlock Text="02  Select older mod" Margin="0,11,0,0" FontSize="12"/>
                            <TextBlock Text="03  Choose targets" Margin="0,11,0,0" FontSize="12"/>
                            <TextBlock Text="04  Patch or build package" Margin="0,11,0,0" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,16" Padding="14"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="{StaticResource CyanBrush}"/>
                                <TextBlock Text="MULTI-MOD SAFE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Only the selected older model becomes the active replacement. Every run is backed up."
                                       Margin="0,8,0,0" FontSize="11" LineHeight="17"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource LimelightVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <Grid Margin="34,24,34,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TOOLS / MODEL MIGRATOR" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock Text="Update older model replacement mods" Margin="0,7,0,0"
                                       FontSize="28" FontWeight="Black"/>
                            <TextBlock Text="Choose one older replacement, then patch only or build its ready-to-share mod package."
                                       Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="13,8" VerticalAlignment="Top"
                                Background="#16192D" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="{StaticResource CyanBrush}"/>
                                <TextBlock Text="UE 5.7" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ConfigurationCard" Grid.Row="1" Margin="0,20,0,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UNREAL PROJECT" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                    <TextBlock Text="Choose the shared project that contains the older model mods."
                                               Margin="0,4,0,9" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBox x:Name="ProjectTextBox" MinWidth="540"
                                             Style="{StaticResource PathTextBoxStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="BROWSE" Margin="12,31,0,0"
                                        VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseProject_Click"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UNREAL ENGINE 5.7" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                    <TextBox x:Name="EditorTextBox" Margin="0,8,0,0"
                                             Style="{StaticResource PathTextBoxStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="BROWSE" Margin="12,26,0,0"
                                        VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseEditor_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="ModSelectionCard" Grid.Row="2" Margin="0,14,0,0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OLDER MODEL MOD" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                    <TextBlock x:Name="ModScanSummaryText"
                                               Text="Choose a project to scan for SK_Charlie replacements."
                                               Margin="0,4,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="SCAN AGAIN" Padding="15,8"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="RefreshMods_Click"/>
                            </Grid>

                            <ListBox x:Name="ModListBox" Margin="0,14,0,0" MaxHeight="245"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="ModListBox_SelectionChanged">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource LimelightVerticalScrollBarStyle}"/>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemSurface" Padding="14,12"
                                                            Background="#0D1020" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemSurface" Property="Background" Value="#25203B"/>
                                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource PinkBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding AssetPath}" Margin="0,4,0,0" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SelectedModBadge" Text="SELECTED MOD"
                                                           Margin="0,0,0,4" HorizontalAlignment="Right"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource PinkBrush}"
                                                           Visibility="Collapsed"/>
                                                <TextBlock Text="{Binding ChunkLabel}" HorizontalAlignment="Right"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Text="{Binding LocationLabel}" Margin="0,3,0,0"
                                                           HorizontalAlignment="Right" FontSize="8"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Value="True">
                                                <Setter TargetName="SelectedModBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,6,0,0" Padding="12,10" Background="#111426"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SELECTED MOD" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                        <TextBlock x:Name="SelectedModText" Text="No mod selected"
                                                   Margin="0,4,0,0" FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="MOD CHUNK" HorizontalAlignment="Right"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource PinkBrush}"/>
                                            <TextBlock x:Name="ChunkStatusText" Text="Select a mod"
                                                       Margin="0,2,0,0" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <TextBox x:Name="ChunkTextBox" Width="58" MaxLength="3"
                                                 HorizontalContentAlignment="Center"
                                                 Style="{StaticResource PathTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TargetsCard" Grid.Row="3" Margin="0,14,0,0"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CURRENT MODEL TARGETS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource PinkBrush}"/>
                                <UniformGrid Columns="3" Margin="0,15,0,0">
                                    <CheckBox x:Name="BodyCheckBox" IsChecked="True" Margin="0,0,16,0"
                                              Style="{StaticResource LimelightCheckBoxStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Gameplay body" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="SK_Charlie_Body" Margin="0,3,0,0" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="PreviewCheckBox" IsChecked="True" Margin="0,0,16,0"
                                              Style="{StaticResource LimelightCheckBoxStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Preview / shadow" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="SK_Charlie_Preview" Margin="0,3,0,0" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="CosmeticsCheckBox" IsChecked="True"
                                              Style="{StaticResource LimelightCheckBoxStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Default cosmetics" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="SK_Charlie_Cosmetics_Default" Margin="0,3,0,0" FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </StackPanel>

                            <Border Grid.Column="1" Margin="26,0,0,0" Padding="26,0,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GLASSES PABP  /  OPTIONAL" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                    <TextBlock x:Name="PabpScanSummaryText"
                                               Text="Choose a project to scan for glasses blueprints."
                                               Margin="0,4,0,9" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox x:Name="PabpComboBox" MinHeight="44"
                                              IsTextSearchEnabled="False"
                                              Style="{StaticResource LimelightComboBoxStyle}">
                                        <ComboBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource LimelightVerticalScrollBarStyle}"/>
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding DetailLabel}" Margin="0,3,0,0" FontSize="8"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox x:Name="NoHairCheckBox" Margin="0,12,0,0"
                                              Style="{StaticResource LimelightCheckBoxStyle}"
                                              Checked="NoHairOption_Changed"
                                              Unchecked="NoHairOption_Changed">
                                        <StackPanel>
                                            <TextBlock Text="No hair" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Install the complete No hair support set and include it in this mod chunk"
                                                       Margin="0,3,0,0" FontSize="8" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid x:Name="NoHairSourcePanel" Margin="0,9,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="CHOOSE SOURCE FOLDER" Padding="12,7"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BrowseNoHairSource_Click"/>
                                        <TextBlock x:Name="NoHairSourceText" Grid.Column="1" Margin="10,0,0,0"
                                                   Text="Uses a complete set already in this project, or choose the original No hair project folder."
                                                   VerticalAlignment="Center" FontSize="8" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,17,0,0" Padding="0,15,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ReplaceCheckBox" IsChecked="True" Margin="0,0,30,0"
                                              Style="{StaticResource LimelightCheckBoxStyle}">
                                        <TextBlock Text="Replace existing current targets" FontSize="11"/>
                                    </CheckBox>
                                    <CheckBox x:Name="LabelCheckBox" IsChecked="True"
                                              Style="{StaticResource LimelightCheckBoxStyle}">
                                        <TextBlock Text="Package selected assets and dependencies in this mod chunk" FontSize="11"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PatchButton" Content="MIGRATE SELECTED MOD" MinWidth="205"
                                Style="{StaticResource PrimaryButton}" Click="PatchProject_Click"/>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="CHOOSE A PROJECT" FontSize="10"
                                       FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="RunModeHelpText"
                                       Text="Updates the project only. You can reopen Unreal and cook it yourself later."
                                       Margin="0,3,0,0" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="RunModePanel" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="RUN MODE" Margin="0,0,0,5" HorizontalAlignment="Right"
                                       FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PatchOnlyRadioButton" Content="PATCH ONLY"
                                             GroupName="RunMode" IsChecked="True" Margin="0,0,6,0"
                                             Style="{StaticResource LimelightRunModeRadioStyle}"
                                             Checked="RunMode_Changed"/>
                                <RadioButton x:Name="PatchAndPackageRadioButton" Content="PATCH + PACKAGE"
                                             GroupName="RunMode"
                                             Style="{StaticResource LimelightRunModeRadioStyle}"
                                             Checked="RunMode_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar x:Name="RunProgressBar" Grid.Column="2" Width="150" Height="4"
                                     VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"
                                     Background="{StaticResource RaisedPanelBrush}"
                                     Foreground="{StaticResource PinkBrush}"/>
                    </Grid>

                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="1" Margin="24,0,24,18" Padding="0" Background="#070810"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#101326" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <StackPanel Margin="14,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,9,0"
                                         Fill="{StaticResource CyanBrush}"/>
                                <TextBlock Text="MIGRATION ACTIVITY" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="LogTextBox" Grid.Row="1" Padding="14,11"
                                 Background="Transparent" Foreground="#C4E8F0" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Ready. Choose the shared Unreal .uproject file.&#x0D;&#x0A;">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource LimelightVerticalScrollBarStyle}"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Panel.ZIndex="900"
              Background="#C9080912" Visibility="Collapsed">
            <Border Width="520" MaxHeight="480" Padding="0" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#171A30" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                        <StackPanel Margin="20,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="DialogIcon" Text="◆" Margin="0,0,12,0" FontSize="15"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock x:Name="DialogTitle" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DialogMessage" Grid.Row="1" Margin="20,18,20,0"
                               FontSize="12" LineHeight="19" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                    <Border x:Name="DialogPathBorder" Grid.Row="2" Margin="20,15,20,0" Padding="12,10"
                            Background="#090B16" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                        <TextBlock x:Name="DialogPath" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="20,20" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="DialogOpenButton" Content="OPEN BACKUP" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                Click="DialogOpen_Click"/>
                        <Button Content="DONE" Style="{StaticResource PrimaryButton}"
                                Click="DialogClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
